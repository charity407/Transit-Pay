OPENAI_API_KEY=sk-your-openai-api-key-here

# XRPL Testnet Wallets (auto-populated by xrpl_treasury.py bootstrap)
CFO_WALLET_SEED=
CARRIER_WALLET_SEED=
AGENT_WALLET_SEED=

# RLUSD Testnet Issuer (from https://tryrlusd.com)
RLUSD_TESTNET_ISSUER=rQhWct2fv4Hhm3KVj3GhW8TQpnfQCMUDed

# Service port
PORT=8001

# CORS — restrict to your frontend origin in production
FRONTEND_ORIGIN=http://localhost:3000

# API Keys — protect treasury control plane endpoints with X-API-Key header.
# Change these before deploying; dev fallbacks are used if unset (local runs only).
CFO_API_KEY=tp_cfo_dev_key_2026
AGENT_API_KEY=tp_agent_dev_key_2026

